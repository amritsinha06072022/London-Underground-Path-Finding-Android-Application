<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DisplayTubeMap">

    <ImageView
        android:id="@+id/tube_map_img"
        android:layout_width="382dp"
        android:layout_height="319dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.448"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/standard_tube_map"
        tools:layout_editor_absoluteY="65dp" />

    <TextView
        android:layout_width="78dp"
        android:layout_height="26dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="23dp"
        android:text="Tube Map"
        app:layout_constraintBottom_toTopOf="@+id/tube_map_img"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/go_home_but"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:onClick="GoToHome"
        android:text="Go To Home"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tube_map_img" />

    <Button
        android:id="@+id/go_plan_route"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:layout_marginTop="48dp"
        android:onClick="GoToPlanRoute"
        android:text="Plan a route"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/go_home_but" />


</androidx.constraintlayout.widget.ConstraintLayout>